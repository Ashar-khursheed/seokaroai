# Tip: Paddle, DataForSEO, AI keys, SMTP and the Google key can also be set in Admin -> Integrations
# (stored encrypted in the database; those values win over the ones below).

# ---------------- Core ----------------
APP_URL=https://seokaroai.com
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/seokaroai
# 48+ random characters (signs checkout data)
SESSION_SECRET=
# Comma-separated emails that become admins on sign-up / login
ADMIN_EMAILS=you@example.com
SUPPORT_EMAIL=support@seokaroai.com

# ---------------- AI (deep audits, keyword battles, auto-fix) ----------------
# Default provider; admins can switch it in Admin → Settings. claude | openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optional: OpenAI (ChatGPT) as the provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_STRATEGY_MODEL=gpt-5
SEO_MODEL=claude-sonnet-5-5
SEO_MAX_CONCURRENT=1
SEO_MAX_QUICK_CONCURRENT=2
# Where run files are stored (default ./data)
# SEO_STUDIO_DATA_DIR=/var/lib/seokaroai
# Windows only, if Git Bash is not in the default location
# CLAUDE_SEO_BASH=C:\Program Files\Git\bin\bash.exe
# Set to 0 on extra web instances so only one process runs the queue and automations
WORKER_ENABLED=1

# ---------------- Connectors (auto-fix) ----------------
# Encrypts WordPress/Shopify/GitHub credentials at rest (falls back to SESSION_SECRET)
ENCRYPTION_KEY=
# Self-hosted only: let admins connect a folder on this server
ALLOW_LOCAL_FOLDERS=0
SHOPIFY_API_VERSION=2025-10

# ---------------- Data providers ----------------
# Rank tracking + live SERP for keyword battles
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# PageSpeed / Lighthouse in site audits
GOOGLE_API_KEY=

# ---------------- Email (SMTP) ----------------
# Without SMTP_HOST, emails are written to data/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SEOKaroAI <no-reply@seokaroai.com>

# ---------------- Payments (Paddle Billing) ----------------
PADDLE_ENV=sandbox
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_AGENCY_MONTHLY=
PADDLE_PRICE_AGENCY_YEARLY=
